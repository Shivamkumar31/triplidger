# Copy to .env; paste the FULL Neon connection string. Never commit .env.
# Single quotes prevent Compose interpolation of any $ characters.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
CACHE_ENABLED=true
REDIS_URL=
CACHE_TTL_SECONDS=60
REDIS_TIMEOUT_MS=250
